<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobhunt.screener</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/3.12/bin/python3</string>
    <string>-I</string>
    <string>/Users/neerajap/JOB HUNT/job-screener/screener.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/neerajap/JOB HUNT/job-screener</string>
  <!-- every 6 hours; a run missed while the Mac sleeps happens on wake -->
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>StandardOutPath</key>
  <string>/Users/neerajap/JOB HUNT/job-screener/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/neerajap/JOB HUNT/job-screener/launchd.log</string>
</dict>
</plist>
